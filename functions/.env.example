# Non-secret SERVER configuration. Copy to .env.magivox-ai on your computer.
# Keep disabled until provider billing and pilot tests have been reviewed.
API_ENABLED=false
JOBS_ENABLED=false
OPENAI_MODEL=gpt-5.6-luna
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Firebase Authentication user UIDs; empty means nobody can call paid AI.
ALLOWED_UIDS=
# pilot = only ALLOWED_UIDS; authenticated = any signed-in non-anonymous user (usage limits still apply).
ACCESS_MODE=pilot
USER_DAILY_UNITS=30
GLOBAL_DAILY_UNITS=300
# OPENAI_API_KEY belongs in Firebase Secret Manager, never in this file.
